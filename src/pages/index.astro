---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import cursorImage from "../assets/cursor.png";
---

<Layout title="Astro">
  <main>
    <h1>Astro и Cursor</h1>
    <Image src={cursorImage} width="200" alt="Cursor AI logo" />
    <p>простые сайты с AI-редактором</p>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    font-size: 20px;
    line-height: 1.6;
    text-align: center;
  }

  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 1em;
  }
</style>
